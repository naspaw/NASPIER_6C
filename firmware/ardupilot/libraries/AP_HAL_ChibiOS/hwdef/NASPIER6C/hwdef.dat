# hw definition file for processing by chibios_hwdef.py
# for the Naspaw NASPIER 6C flight controller
#
# FMUv6C-class board: STM32H743 FMU + STM32F103 IOMCU.
# The FMU pinout follows the Pixhawk FMUv6C reference (see Pixhawk6C/hwdef.dat).
# Schematics: https://github.com/naspaw/NASPIER_6C
#
# DRAFT: not submitted upstream. The board ID is not allocated in
# Tools/AP_Bootloader/board_types.txt and no USB VID/PID is assigned.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# crystal frequency (X1, 16MHz)
OSCILLATOR_HZ 16000000

# ChibiOS system timer
STM32_ST_USE_TIMER 2

# USB setup
# USB_VENDOR and USB_PRODUCT are intentionally not set (draft), so the
# ArduPilot defaults are used
USB_STRING_MANUFACTURER "Naspaw"

# board ID. See Tools/AP_Bootloader/board_types.txt
# DRAFT: AP_HW_NASPIER6C has no number allocated yet
APJ_BOARD_ID AP_HW_NASPIER6C

# bootloader takes first sector
FLASH_RESERVE_START_KB 128

# flash size
FLASH_SIZE_KB 2048

# order of UARTs (and USB)
SERIAL_ORDER OTG1 UART7 UART5 USART1 UART8 USART2 USART3 OTG2

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN

# pins for SWD debugging (FC Debug header)
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# TELEM1
PE8  UART7_TX UART7
PE7  UART7_RX UART7
PE9  UART7_RTS UART7 LOW PULLDOWN
PE10 UART7_CTS UART7

# TELEM2
PC12 UART5_TX UART5
PD2  UART5_RX UART5
PC8  UART5_RTS UART5 LOW PULLDOWN
PC9  UART5_CTS UART5

# GPS1 (Full GPS port)
PB6  USART1_TX USART1
PA10 USART1_RX USART1

# GPS2 (Basic GPS port)
PE1 UART8_TX UART8
PE0 UART8_RX UART8

# TELEM3 (shares its connector with I2C2)
PD5 USART2_TX USART2
PA3 USART2_RX USART2

# debug uart (FC Debug header)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# USART6 is for IOMCU
PC6 USART6_TX USART6
PC7 USART6_RX USART6

IOMCU_UART USART6

# ADC

# Direct Battery input (XT30). The INA168 current sense amplifier is not
# populated on this revision, so only voltage is available by default.
PC5 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC4 BATT_CURRENT_SENS ADC1 SCALE(1)

# Brick input (JST GH 6 pin), analog power module
PB1 BATT2_VOLTAGE_SENS ADC1 SCALE(1)
PA2 BATT2_CURRENT_SENS ADC1 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 3
define HAL_BATT_VOLT_PIN 8
define HAL_BATT_CURR_PIN 4
# (R56 56.2k + R57 105k + R45 10k) / R45 10k
define HAL_BATT_VOLT_SCALE 17.12
# only valid if the INA168 (1mOhm shunt, 249k gain resistor) is populated
define HAL_BATT_CURR_SCALE 20.08

# brick input is disabled by default, set BATT2_MONITOR=4 to use it.
# Scales match a Holybro PM02 style analog power module.
define HAL_BATT2_VOLT_PIN 5
define HAL_BATT2_CURR_PIN 14
define HAL_BATT2_VOLT_SCALE 18.18
define HAL_BATT2_CURR_SCALE 36.36

PA4 VDD_5V_SENS ADC1 SCALE(2)

# SPI1 - IMUs on the NASPIER_IMU-01 sensor board, through the FC-FLEX connector
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1
PC13 IIM42653_CS CS
PC14 BMI088_G_CS CS
PC15 BMI088_A_CS CS
PE4  BMI088_DRDY_A INPUT
PE5  BMI088_DRDY_G INPUT
PE6  IIM42653_DRDY INPUT

# SPI2 - FRAM
PD3 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2
PD4 FRAM_CS CS

# PWM output pins, FMU outputs (AUX)
PA8  TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)
PD14 TIM4_CH3 TIM4 PWM(5) GPIO(54)
PD15 TIM4_CH4 TIM4 PWM(6) GPIO(55)
PA0  TIM5_CH1 TIM5 PWM(7) GPIO(56)
PA1  TIM5_CH2 TIM5 PWM(8) GPIO(57)

# CAN bus, TJA1051 transceivers with the S pin tied low
PD0  CAN1_RX CAN1
PD1  CAN1_TX CAN1

PB5  CAN2_RX CAN2
PB13 CAN2_TX CAN2

# I2C buses

# I2C1, GPS1 compass and LED
PB7 I2C1_SDA I2C1
PB8 I2C1_SCL I2C1

# I2C2, GPS2 compass and LED, TELEM3 connector
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

# I2C4 internal: MS5611 on the main board, IST8310 and 24C02 on the sensor board
PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

# order of I2C buses
I2C_ORDER I2C4 I2C1 I2C2
define HAL_I2C_INTERNAL_MASK 1

# heater on the sensor board, FMU_HEATER through the FC-FLEX connector
PB9 HEATER_EN OUTPUT LOW GPIO(80)
define HAL_HEATER_GPIO_PIN 80

# Setup the IMU heater. Gains are taken from Pixhawk6C and need tuning
# for the NASPIER_IMU-01 heater.
define HAL_HAVE_IMU_HEATER 1
define HAL_IMU_TEMP_DEFAULT 45
define HAL_IMUHEAT_P_DEFAULT 50
define HAL_IMUHEAT_I_DEFAULT 0.07

# power enable pins. One pin enables all four sensor LDOs (3V3_S1 to 3V3_S4)
PB2 VDD_3V3_SENSORS_EN OUTPUT HIGH

# start peripheral power on
PC10 nVDD_5V_HIPOWER_EN OUTPUT LOW
PE2  nVDD_5V_PERIPH_EN  OUTPUT LOW

# power sensing
PE3  VDD_5V_PERIPH_nOC INPUT PULLUP
PC11 VDD_5V_HIPOWER_nOC INPUT PULLUP

# LTC4417 power mux valid outputs
# VALID1: onboard 5V from Direct Battery, VALID2: Brick input, VALID3: USB
PA15 VDD_BRICK_nVALID INPUT PULLUP
PB12 VDD_BRICK2_nVALID INPUT PULLUP
PE15 VBUS_nVALID INPUT PULLUP

# microSD support
PD6  SDMMC2_CK SDMMC2
PD7  SDMMC2_CMD SDMMC2
PB14 SDMMC2_D0 SDMMC2
PB15 SDMMC2_D1 SDMMC2
PB3  SDMMC2_D2 SDMMC2
PB4  SDMMC2_D3 SDMMC2
define FATFS_HAL_DEVICE SDCD2

# LEDs, active low
PD10 LED_RED OUTPUT OPENDRAIN GPIO(90) HIGH
PD11 LED_BLUE OUTPUT OPENDRAIN GPIO(92) HIGH

# setup for BoardLED2
define AP_NOTIFY_GPIO_LED_2_ENABLED 1
define HAL_GPIO_A_LED_PIN 90
define HAL_GPIO_B_LED_PIN 92

# ID pins
PE12 HW_VER_REV_DRIVE OUTPUT LOW

# PWM output for buzzer, drives Q4 on the GPS1 connector buzzer pin
PB0 TIM3_CH3 TIM3 GPIO(77) ALARM

# barometer, CSB pulled high
BARO MS5611 I2C:0:0x76

# compass
define AP_COMPASS_PROBING_ENABLED 1
COMPASS IST8310 I2C:0:0x0C false ROTATION_NONE

# stop the generic probe of an IST8310 as an internal compass with PITCH_180
define AP_COMPASS_IST8310_INTERNAL_BUS_PROBING_ENABLED 0

# SPI devices
SPIDEV bmi088_g  SPI1 DEVID1 BMI088_G_CS  MODE3 10*MHZ 10*MHZ
SPIDEV bmi088_a  SPI1 DEVID2 BMI088_A_CS  MODE3 10*MHZ 10*MHZ
SPIDEV iim42653  SPI1 DEVID3 IIM42653_CS  MODE3  2*MHZ  8*MHZ
SPIDEV ramtron   SPI2 DEVID1 FRAM_CS      MODE3  8*MHZ  8*MHZ

# 2 IMUs. Rotations assume the sensor board is mounted top side up with
# its arrow pointing forward, see hardware/sensor-board/README.md
IMU Invensensev3 SPI:iim42653 ROTATION_ROLL_180
IMU BMI088 SPI:bmi088_a SPI:bmi088_g ROTATION_ROLL_180

define HAL_DEFAULT_INS_FAST_SAMPLE 3

# enable RAMTRON parameter storage, FM25V02A 256Kbit
define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

# dedicated safety switch on the GPS1 connector, read by the IOMCU
define HAL_HAVE_SAFETY_SWITCH 1

DMA_PRIORITY SDMMC* USART6* ADC* UART* USART* SPI* TIM*

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

# IOMCU is an STM32F103 with a 24MHz crystal (X2), same as Pixhawk6C
ROMFS io_firmware.bin Tools/IO_Firmware/iofirmware_f103_lowpolh.bin

# build ABIN for flash-from-bootloader support:
env BUILD_ABIN True

# enable support for dshot on iomcu
ROMFS io_firmware_dshot.bin Tools/IO_Firmware/iofirmware_f103_dshot_lowpolh.bin
define HAL_WITH_IO_MCU_BIDIR_DSHOT 1
