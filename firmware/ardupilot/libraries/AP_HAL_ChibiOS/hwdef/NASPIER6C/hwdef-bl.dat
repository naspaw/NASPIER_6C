# hw definition file for processing by chibios_hwdef.py
# for the Naspaw NASPIER 6C bootloader
#
# DRAFT: not submitted upstream. The board ID is not allocated in
# Tools/AP_Bootloader/board_types.txt and no USB VID/PID is assigned.

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# crystal frequency (X1, 16MHz)
OSCILLATOR_HZ 16000000

# USB setup
# USB_VENDOR and USB_PRODUCT are intentionally not set (draft)
USB_STRING_MANUFACTURER "Naspaw"

# board ID. See Tools/AP_Bootloader/board_types.txt
# DRAFT: AP_HW_NASPIER6C has no number allocated yet
APJ_BOARD_ID AP_HW_NASPIER6C

# bootloader is installed at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
FLASH_BOOTLOADER_LOAD_KB 128

# flash size
FLASH_SIZE_KB 2048

# order of UARTs (and USB)
SERIAL_ORDER OTG1 UART7 UART5 USART3

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN

# pins for SWD debugging
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# CS pins, held high so the sensors and FRAM stay off the bus
PC13 IIM42653_CS CS
PC14 BMI088_G_CS CS
PC15 BMI088_A_CS CS
PD4 FRAM_CS CS

# TELEM1
PE8  UART7_TX UART7
PE7  UART7_RX UART7

# TELEM2
PC12 UART5_TX UART5
PD2  UART5_RX UART5

# debug uart
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# start peripheral power on
PC10 nVDD_5V_HIPOWER_EN OUTPUT LOW
PE2  nVDD_5V_PERIPH_EN  OUTPUT LOW

# LEDs
PD10 LED_ACTIVITY OUTPUT OPENDRAIN GPIO(90) HIGH # red
PD11 LED_BOOTLOADER OUTPUT OPENDRAIN GPIO(92) HIGH # blue
define HAL_LED_ON 0

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 16384

# support flashing from SD card:

# FATFS support:
define CH_CFG_USE_MEMCORE 1
define CH_CFG_USE_HEAP 1
define CH_CFG_USE_SEMAPHORES 0
define CH_CFG_USE_MUTEXES 1
define CH_CFG_USE_DYNAMIC 1
define CH_CFG_USE_WAITEXIT 1
define CH_CFG_USE_REGISTRY 1

# microSD support
PD6  SDMMC2_CK SDMMC2
PD7  SDMMC2_CMD SDMMC2
PB14 SDMMC2_D0 SDMMC2
PB15 SDMMC2_D1 SDMMC2
PB3  SDMMC2_D2 SDMMC2
PB4  SDMMC2_D3 SDMMC2
define FATFS_HAL_DEVICE SDCD2

DMA_PRIORITY SDMMC* USART6* ADC* UART* USART* SPI* TIM*

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

define AP_BOOTLOADER_FLASH_FROM_SD_ENABLED 1
